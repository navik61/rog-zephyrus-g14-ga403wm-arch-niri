[Unit]
Description=Watcher pro fyzickou AURA klávesu (Fn+F4) - cyklení RGB efektů
After=multi-user.target asusd.service
Wants=asusd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/aura-key-watch.py
Restart=on-failure
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
