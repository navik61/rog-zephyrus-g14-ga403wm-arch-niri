[Unit]
Description=Watcher for the physical AURA key (Fn+F4) - cycles RGB effects
After=multi-user.target asusd.service
Wants=asusd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/aura-key-watch.py
Restart=on-failure
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
